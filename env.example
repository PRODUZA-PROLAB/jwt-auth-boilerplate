# Ambiente da aplicação
NODE_ENV=development
PORT=3000

# Segredos JWT — OBRIGATÓRIOS em produção. Use valores fortes e diferentes.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Tempo de vida dos tokens (s, m, h, d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Pepper aplicado ao hashing de senha (scrypt). Use um valor fixo e forte em produção.
PASSWORD_PEPPER=
